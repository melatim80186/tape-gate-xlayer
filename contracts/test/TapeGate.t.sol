pragma solidity ^0.8.24;

import {Test, console} from "forge-std/Test.sol";
import {TapeCircuit} from "../src/TapeCircuit.sol";
import {TapeGateVault} from "../src/TapeGateVault.sol";

/// @notice Spend-policy netlist, generated by circuit/build-netlist.mjs:
///  0x0106010a00010606060707020808080909030a0a0a0b0b040c0c0c0d0d050e0e0e0f0f
///  10 NAND gates, OUT = AND of all 6 inputs. Only 0b111111 authorises.
/// @notice External wrapper so vm.expectRevert can catch evaluator reverts
///  (internal library calls revert in the caller and bypass expectRevert).
contract EvaluatorHarness {
    function evaluate(bytes calldata netlist, uint256 inputs) external pure returns (uint256) {
        return TapeCircuit.evaluate(netlist, inputs);
    }
}

contract TapeGateTest is Test {
    bytes constant NETLIST = hex"0106010a00010606060707020808080909030a0a0a0b0b040c0c0c0d0d050e0e0e0f0f";

    TapeGateVault vault;
    uint256 agentKey = 0xA11CE;
    address agent;
    address recipient = address(0xBEEF);
    uint256 budgetCap = 10 ether;
    uint256 perSpendCap = 1 ether;

    function setUp() public {
        agent = vm.addr(agentKey);
        uint256 start = vm.getBlockTimestamp();
        vault = new TapeGateVault(agent, budgetCap, perSpendCap, start, start + 30 days);
        vault.registerCircuit(NETLIST);
        vm.deal(address(vault), 5 ether);
    }

    // --- circuit evaluator: exhaustive 64-combination cross-check ---

    function testEvaluatorExhaustive() public pure {
        for (uint256 v; v < 64; v++) {
            uint256 out = TapeCircuit.evaluate(NETLIST, v);
            assertEq(out, v == 63 ? 1 : 0, "evaluator mismatch");
        }
    }

    function testEvaluatorRejectsBadNetlist() public {
        EvaluatorHarness h = new EvaluatorHarness();
        bytes memory bad = hex"0206010a00010606060707020808080909030a0a0a0b0b040c0c0c0d0d050e0e0e0f0f";
        vm.expectRevert(TapeCircuit.BadNetlist.selector);
        h.evaluate(bad, 63);
        bytes memory truncated = hex"0106010a000106";
        vm.expectRevert(TapeCircuit.BadNetlist.selector);
        h.evaluate(truncated, 63);
    }

    function testRegisterCircuitRejectsDegenerate() public {
        // Netlist that authorises all-zero inputs must be refused.
        // Single gate NAND(0,0) -> out 1, output = that signal: 0-inputs => 1.
        bytes memory bad = hex"0101010100000202";
        vm.expectRevert(TapeCircuit.BadNetlist.selector);
        vault.registerCircuit(bad);
    }

    // --- vault happy path ---

    function _sign(bytes32 requestId, address to, uint256 amount, uint256 inputs, uint256 deadline)
        internal
        view
        returns (bytes memory)
    {
        bytes32 h = vault.decisionHash(requestId, to, amount, inputs, deadline);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(agentKey, h);
        return abi.encodePacked(r, s, v);
    }

    function testHappyPathSpend() public {
        uint256 amount = 0.1 ether;
        uint256 inputs = vault.buildInputs(recipient, amount, true);
        assertEq(inputs, 63, "inputs should be all-ones");
        bytes32 requestId = keccak256("req-1");
        uint256 deadline = block.timestamp + 1 hours;
        bytes memory sig = _sign(requestId, recipient, amount, inputs, deadline);

        uint256 before = recipient.balance;
        vault.executeSpend(requestId, recipient, amount, deadline, sig);
        assertEq(recipient.balance - before, amount);
        assertEq(vault.spentTotal(), amount);
        assertTrue(vault.usedRequestIds(requestId));
    }

    // --- vault rejections ---

    function testRejectRevokedRecipient() public {
        vault.setRevoked(recipient, true);
        uint256 amount = 0.1 ether;
        // Agent would refuse too, but even with a (bad) agent signature the
        // on-chain circuit must block: buildInputs gives bit2 = 0.
        uint256 inputs = vault.buildInputs(recipient, amount, true);
        assertEq(inputs, 63 - 4, "revoked bit must be 0");
        bytes32 requestId = keccak256("req-revoked");
        uint256 deadline = block.timestamp + 1 hours;
        bytes memory sig = _sign(requestId, recipient, amount, inputs, deadline);
        vm.expectRevert(TapeGateVault.CircuitRejected.selector);
        vault.executeSpend(requestId, recipient, amount, deadline, sig);
    }

    function testRejectOverCap() public {
        uint256 amount = 2 ether; // > perSpendCap 1 ether
        uint256 inputs = vault.buildInputs(recipient, amount, true);
        assertEq(inputs & (1 << 4), 0, "amountOK bit must be 0");
        bytes32 requestId = keccak256("req-cap");
        uint256 deadline = block.timestamp + 1 hours;
        bytes memory sig = _sign(requestId, recipient, amount, inputs, deadline);
        vm.expectRevert(TapeGateVault.CircuitRejected.selector);
        vault.executeSpend(requestId, recipient, amount, deadline, sig);
    }

    function testRejectBadAgentSignature() public {
        uint256 amount = 0.1 ether;
        uint256 inputs = 63;
        bytes32 requestId = keccak256("req-badsig");
        uint256 deadline = block.timestamp + 1 hours;
        // Sign with a different key.
        bytes32 h = vault.decisionHash(requestId, recipient, amount, inputs, deadline);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(0xBAD, h);
        vm.expectRevert(TapeGateVault.BadSignature.selector);
        vault.executeSpend(requestId, recipient, amount, deadline, abi.encodePacked(r, s, v));
    }

    function testRejectReplay() public {
        uint256 amount = 0.1 ether;
        uint256 inputs = 63;
        bytes32 requestId = keccak256("req-replay");
        uint256 deadline = block.timestamp + 1 hours;
        bytes memory sig = _sign(requestId, recipient, amount, inputs, deadline);
        vault.executeSpend(requestId, recipient, amount, deadline, sig);
        vm.expectRevert(TapeGateVault.Replay.selector);
        vault.executeSpend(requestId, recipient, amount, deadline, sig);
    }

    function testRejectExpired() public {
        uint256 amount = 0.1 ether;
        uint256 inputs = 63;
        bytes32 requestId = keccak256("req-expired");
        uint256 deadline = block.timestamp + 1 hours;
        bytes memory sig = _sign(requestId, recipient, amount, inputs, deadline);
        vm.warp(block.timestamp + 2 hours);
        vm.expectRevert(TapeGateVault.Expired.selector);
        vault.executeSpend(requestId, recipient, amount, deadline, sig);
    }

    function testRejectWhenPaused() public {
        vault.setPaused(true);
        uint256 amount = 0.1 ether;
        bytes32 requestId = keccak256("req-paused");
        uint256 deadline = block.timestamp + 1 hours;
        bytes memory sig = _sign(requestId, recipient, amount, 63, deadline);
        vm.expectRevert(TapeGateVault.PausedVault.selector);
        vault.executeSpend(requestId, recipient, amount, deadline, sig);
    }

    function testTapeoutConstants() public view {
        assertEq(vault.TAPEOUT_PROCESSOR(), 0x69F663931209096037474d7C20402232E5C762cA);
        assertEq(vault.TAPEOUT_OPENER(), 0x536adD8F30f03b69f6fbF29d425A816A0dC50106);
        assertEq(vault.tapeoutCircuitId(), 0, "no tapeout yet in tests");
    }
}
